<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
      SB-001
      JPA entity validates scientific feature-item invariants during
      construction. The class cannot be final because persistence
      providers may require proxying. No finalizer is implemented.
    -->
    <Match>
        <Class
            name="com.inclusive.adaptiveeducationservice.featurestore.scientific.persistence.entity.ScientificFeatureItemEntity"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

