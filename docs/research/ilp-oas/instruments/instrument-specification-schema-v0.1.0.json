{
    "$schema":  "http://json-schema.org/draft-07/schema#",
    "title":  "ILP original instrument specification",
    "type":  "object",
    "required":  [
                     "schemaVersion",
                     "instrumentId",
                     "version",
                     "title",
                     "language",
                     "status",
                     "purpose",
                     "population",
                     "safety",
                     "instructions",
                     "responseScale",
                     "dimensions",
                     "items",
                     "scoring",
                     "interpretation"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "type":  "string"
                                         },
                       "instrumentId":  {
                                            "type":  "string",
                                            "pattern":  "^ILP-[A-Z]{3}$"
                                        },
                       "version":  {
                                       "type":  "string"
                                   },
                       "title":  {
                                     "type":  "string"
                                 },
                       "language":  {
                                        "type":  "string"
                                    },
                       "status":  {
                                      "const":  "candidate_not_validated"
                                  },
                       "purpose":  {
                                       "type":  "string"
                                   },
                       "dimensions":  {
                                          "type":  "array",
                                          "minItems":  1
                                      },
                       "items":  {
                                     "type":  "array",
                                     "minItems":  1,
                                     "uniqueItems":  true
                                 },
                       "responseScale":  {
                                             "type":  "object"
                                         },
                       "scoring":  {
                                       "type":  "object"
                                   },
                       "interpretation":  {
                                              "type":  "object"
                                          }
                   }
}
