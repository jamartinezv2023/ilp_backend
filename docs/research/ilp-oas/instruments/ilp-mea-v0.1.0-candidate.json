                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-EA-02",
                      "dimension":  "EA",
                      "text":  "Organizo los materiales y recursos que necesito antes de comenzar.",
