                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AC-04",
                      "dimension":  "AC",
                      "text":  "Cuando trabajo en grupo, aporto razones y escucho las de los demás.",
