                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AC-05",
                      "dimension":  "AC",
                      "text":  "Uso la retroalimentación para mejorar una respuesta o procedimiento.",
