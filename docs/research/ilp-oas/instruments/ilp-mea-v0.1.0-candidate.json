                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-01",
                      "dimension":  "AM",
                      "text":  "Antes de empezar, defino qué debo lograr y cuánto tiempo puedo dedicar.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-02",
                      "dimension":  "AM",
                      "text":  "Mientras trabajo, verifico si estoy avanzando hacia el objetivo.",
