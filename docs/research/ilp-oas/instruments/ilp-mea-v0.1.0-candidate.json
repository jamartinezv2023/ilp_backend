                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AC-01",
                      "dimension":  "AC",
                      "text":  "Pido una aclaración específica cuando no comprendo una parte de la actividad.",
