                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-EA-01",
                      "dimension":  "EA",
                      "text":  "Identifico qué condiciones del lugar facilitan o dificultan mi concentración.",
