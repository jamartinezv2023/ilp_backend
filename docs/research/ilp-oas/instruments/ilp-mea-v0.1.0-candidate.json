                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AC-06",
                      "dimension":  "AC",
                      "text":  "Ofrezco apoyo respetuoso cuando otra persona lo solicita.",
