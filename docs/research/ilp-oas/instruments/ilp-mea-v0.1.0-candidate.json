                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-05",
                      "dimension":  "RM",
                      "text":  "Combino palabras, símbolos e imágenes cuando necesito comunicar una idea compleja.",
