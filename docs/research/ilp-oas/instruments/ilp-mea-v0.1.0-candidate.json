                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-02",
                      "dimension":  "RM",
                      "text":  "Uso diagramas, gráficos o dibujos cuando ayudan a comprender relaciones.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-03",
                      "dimension":  "RM",
                      "text":  "Transformo una representación en otra, por ejemplo, de una tabla a una explicación escrita.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-04",
                      "dimension":  "RM",
                      "text":  "Los ejemplos concretos me ayudan a interpretar expresiones abstractas.",
