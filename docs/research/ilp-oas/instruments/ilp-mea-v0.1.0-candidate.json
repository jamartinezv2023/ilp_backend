                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AC-03",
                      "dimension":  "AC",
                      "text":  "Puedo explicar qué tipo de ayuda necesito para continuar.",
