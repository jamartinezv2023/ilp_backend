                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-EA-03",
                      "dimension":  "EA",
                      "text":  "Uso herramientas tecnológicas cuando mejoran mi acceso o comprensión.",
