                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-04",
                      "dimension":  "AM",
                      "text":  "Cambio mi plan cuando la estrategia inicial no produce el resultado esperado.",
