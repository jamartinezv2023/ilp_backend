                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-01",
                      "dimension":  "RM",
                      "text":  "Si una explicación verbal no es suficiente, busco otra forma de representar la idea.",
