                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-05",
                      "dimension":  "AM",
                      "text":  "Al terminar, compruebo si mi respuesta cumple lo solicitado.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-06",
                      "dimension":  "AM",
                      "text":  "Reconozco qué parte de una tarea requiere más esfuerzo o apoyo.",
