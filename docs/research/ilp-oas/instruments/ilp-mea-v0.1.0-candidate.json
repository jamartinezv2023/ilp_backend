                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-RM-06",
                      "dimension":  "RM",
                      "text":  "Elijo la representación que mejor se ajusta al tipo de problema.",
