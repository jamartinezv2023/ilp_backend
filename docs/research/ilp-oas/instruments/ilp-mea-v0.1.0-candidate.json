                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-OI-06",
                      "dimension":  "OI",
                      "text":  "Uso títulos, categorías o secuencias para ubicar rápidamente la información.",
