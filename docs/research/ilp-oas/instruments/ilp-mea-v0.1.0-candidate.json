    "items":  [
                  {
                      "id":  "MEA-OI-01",
                      "dimension":  "OI",
                      "text":  "Antes de estudiar un tema, identifico qué información es central y cuál es complementaria.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-OI-02",
                      "dimension":  "OI",
                      "text":  "Divido una tarea extensa en pasos que puedo realizar y revisar.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-OI-03",
                      "dimension":  "OI",
                      "text":  "Agrupo ideas relacionadas para recordar cómo se conectan.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-OI-04",
                      "dimension":  "OI",
                      "text":  "Elaboro resúmenes que conservan las relaciones importantes del tema.",
                      "required":  false,
                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-OI-05",
                      "dimension":  "OI",
                      "text":  "Ordeno datos o argumentos antes de elaborar una respuesta.",
