                      "scoring":  {
                                      "direction":  "forward",
                                      "weight":  1
                                  },
                      "status":  "candidate_for_expert_and_cognitive_review"
                  },
                  {
                      "id":  "MEA-AM-03",
                      "dimension":  "AM",
                      "text":  "Si pierdo la concentración, utilizo una acción concreta para retomarla.",
