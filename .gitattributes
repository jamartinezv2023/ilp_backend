#
# Repository line-ending policy
#

# Gradle Linux launcher must remain LF.
/gradlew text eol=lf

# Windows command scripts use CRLF.
*.bat text eol=crlf

# CI/CD configuration must remain portable on Linux runners.
*.yml text eol=lf
*.yaml text eol=lf

# Binary artifacts must not be normalized.
*.jar binary

# Git attributes file itself uses LF.
/.gitattributes text eol=lf
*.sh text eol=lf
